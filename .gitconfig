[alias]
  co = checkout
  fe = fetch --all
  ca = commit --amend
  aa = add --all
  s = status
  c = commit
  d = diff
  cl = clean -dfX
  bl = branch --list
  ci = !git checkout $(git branch -a | fzf | xargs)
  ri = !git rebase -i $(git branch -a | fzf | xargs)
  up = pull --rebase origin master
  publish = push -u origin HEAD
  pf = publish -f
  sl = rebase -i HEAD~2
  l = log --pretty='format:%C(ul)%h%Creset |%C(yellow)%<(16,trunc) %an %Creset|%C(yellow)%<(20,trunc) %ae %Creset| %<(80,trunc)%C(cyan)%s %Creset| %C(green)%ad%Creset' --no-merges --date='format:%b %d, %Y'
[core]
  editor = vim
